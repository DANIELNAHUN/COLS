# Line-ending policy for the Windows-first COLS repo.
# ktlint (Spotless) requires LF in Kotlin/Kotlin-DSL sources; core.autocrlf=true
# would otherwise regenerate CRLF on every Windows clone and break the format
# gate. These rules pin the working-tree endings durably.
*.gradle.kts text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf
